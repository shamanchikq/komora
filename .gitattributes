# Normalise to LF in the repository. CI and development both run on Linux; the rule
# stays because the history was written on Windows and .bat/.cmd/.ps1 still need CRLF.
* text=auto eol=lf

# Windows-only files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated; collapse in diffs and exclude from language stats.
uv.lock -diff linguist-generated=true
