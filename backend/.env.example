# Copy to .env and fill in. Never commit .env.

# --- Required ---

# From @BotFather on Telegram.
KOMORA_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# From Google AI Studio (https://aistudio.google.com/apikey).
# Required only if a tier below uses a gemini/* model. An all-Ollama config needs no key.
KOMORA_GEMINI_API_KEY=

# Encrypts Silpo OAuth tokens at rest. Generate with:
#   uv run python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotating this invalidates every stored token — all users must re-authenticate.
KOMORA_TOKEN_ENCRYPTION_KEY=

# Public HTTPS base for the Silpo OAuth callback. No trailing slash.
# In development this is your tunnel: cloudflared tunnel --url http://localhost:8000
# The bot uses long polling, so only this callback needs to be reachable.
KOMORA_PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# --- Optional (defaults shown) ---

# The Mini App's own t.me link, exactly as BotFather reports it after
# /newapp. Deep links are this plus "?startapp=basket_<id>", and the bot renders an
# «Відкрити в Коморі» button on every draft when it is set. Leave it empty until the
# app is actually published: a guessed short name opens a 404 inside Telegram.
# KOMORA_TELEGRAM_MINI_APP_URL=https://t.me/your_bot/komora

# KOMORA_SILPO_MCP_URL=https://mcp.silpo.ua/mcp
# KOMORA_DATABASE_URL=sqlite+aiosqlite:///./komora.db
# KOMORA_HTTP_PORT=8000

# Two-tier model routing, as "provider/model" refs. LITE runs the agent loop (the
# basket proposal); FULL runs the verification pass. Changing model — or provider — is
# an env var, never a code change.
#
# POINT THEM AT DIFFERENT MODELS. Gemini's free-tier quota is keyed on
# (project, model) — Google's own 429 payloads name
# `GenerateRequestsPerDayPerProjectPerModel-FreeTier` with the model as a dimension —
# and a basket costs one request on each tier. Two models therefore draw on two
# independent daily allowances; the same model on both halves your baskets per day.
#
#   gemini/gemini-2.5-flash-lite   $0.10/$0.40   cost floor; no shutdown date announced
#   gemini/gemini-3.1-flash-lite   $0.25/$1.50   EOL 2027-05-07; replaced by 3.5
#   gemini/gemini-3.5-flash-lite   $0.30/$2.50   newest lite — NOT cheaper than 3.1
#   gemini/gemini-3.6-flash        $1.50/$7.50   overkill for both of these jobs
#   ollama/<tag>                   free          local; verified with gemma4:12b
#
# Measured on this project's own prompts, n=5 (scripts/compare_models.py): 3.1 and 3.5
# pass at the same rate, but 3.5 names a Silpo category on nearly every basket line
# where 3.1 mostly omits it — and a category is what lets `resolve` browse the taxonomy
# instead of searching free text. Re-measure before trusting this; the numbers are
# small and models change under you.
#
# KOMORA_LLM_AGENT=gemini/gemini-3.5-flash-lite
# KOMORA_LLM_VERIFIER=gemini/gemini-3.1-flash-lite

# --- Local development profile: free, offline, no API key ---
# DEVELOPMENT ONLY. Not a production default: the best local candidate scores ~45% on
# BFCL multi-turn vs 61-68% for hosted frontier models — roughly one basket flow in two
# completes correctly, before any Ukrainian penalty. A silently wrong grocery order is
# worse than an error. See spec §4.1 for the promotion gate.
#
# Requires Ollama > 0.20.0 (older versions silently drop schema constraints when
# `think: false` is combined with `format`).
#
# Prefer BASE instruct models. Agent-tuned variants (gemma4-agent, qwen3.6:27b) search
# instead of proposing — a known "Always-Call" pathology, and searching is the resolve
# pass's job. Avoid gemma4:e4b: 2-3.5 minutes per turn at 5-8 steps.
#
# KOMORA_LLM_AGENT=ollama/gemma4:12b
# KOMORA_LLM_VERIFIER=ollama/gemma4:12b
# KOMORA_OLLAMA_BASE_URL=http://localhost:11434
