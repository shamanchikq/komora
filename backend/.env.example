# Copy to .env and fill in. Never commit .env.

# --- Required ---

# From @BotFather on Telegram.
KOMORA_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# From Google AI Studio (https://aistudio.google.com/apikey).
# Required only if a tier below uses a gemini/* model. An all-Ollama config needs no key.
KOMORA_GEMINI_API_KEY=

# Encrypts Silpo OAuth tokens at rest. Generate with:
#   uv run python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotating this invalidates every stored token — all users must re-authenticate.
KOMORA_TOKEN_ENCRYPTION_KEY=

# Public HTTPS base for the Silpo OAuth callback. No trailing slash.
# In development this is your tunnel: cloudflared tunnel --url http://localhost:8000
# The bot uses long polling, so only this callback needs to be reachable.
KOMORA_PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# --- Optional (defaults shown) ---

# KOMORA_SILPO_MCP_URL=https://mcp.silpo.ua/mcp
# KOMORA_DATABASE_URL=sqlite+aiosqlite:///./komora.db
# KOMORA_HTTP_PORT=8000

# Two-tier model routing, as "provider/model" refs. Cheap tier for intent routing and
# ordinary conversation; stronger tier for meal planning and multi-step tool loops.
# Changing model — or provider — is an env var, never a code change.
#
#   gemini/gemini-2.5-flash-lite   $0.10/$0.40   cost floor; no shutdown date announced
#   gemini/gemini-3.1-flash-lite   $0.25/$1.50   default lite; EOL 2027-05-07
#   gemini/gemini-3.5-flash-lite   $0.30/$2.50   newest lite — faster, NOT cheaper
#   gemini/gemini-3.6-flash        $1.50/$7.50   default full
#   ollama/<tag>                   free          local; verified with gemma4:12b
#
# KOMORA_LLM_LITE=gemini/gemini-3.1-flash-lite
# KOMORA_LLM_FULL=gemini/gemini-3.6-flash

# --- Local development profile: free, offline, no API key ---
# Verified 2026-08-10: gemma4:12b picked the right tool from 21, filled the nested
# propose_basket schema, and wrote Ukrainian reasons in 3.3s.
# Prefer base instruct models — agent-tuned variants search instead of proposing,
# which is the resolve pass's job, not the LLM's.
#
# KOMORA_LLM_LITE=ollama/gemma4:12b
# KOMORA_LLM_FULL=ollama/gemma4:12b
# KOMORA_OLLAMA_BASE_URL=http://localhost:11434
