# Copy to .env and fill in. Never commit .env.

# --- Required ---

# From @BotFather on Telegram.
KOMORA_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# From Google AI Studio (https://aistudio.google.com/apikey).
KOMORA_GEMINI_API_KEY=

# Encrypts Silpo OAuth tokens at rest. Generate with:
#   uv run python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotating this invalidates every stored token — all users must re-authenticate.
KOMORA_TOKEN_ENCRYPTION_KEY=

# Public HTTPS base for the Silpo OAuth callback. No trailing slash.
# In development this is your tunnel: cloudflared tunnel --url http://localhost:8000
# The bot uses long polling, so only this callback needs to be reachable.
KOMORA_PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# --- Optional (defaults shown) ---

# KOMORA_SILPO_MCP_URL=https://mcp.silpo.ua/mcp
# KOMORA_DATABASE_URL=sqlite+aiosqlite:///./komora.db
# KOMORA_HTTP_PORT=8000

# Two-tier model routing: cheap tier for intent routing and ordinary conversation,
# stronger tier for meal planning and multi-step tool loops.
# KOMORA_GEMINI_MODEL_LITE=
# KOMORA_GEMINI_MODEL_FULL=
